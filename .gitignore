# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# CLI self-improvement signals
.pof/

# Claude Code logs + transient agent/idea artifacts
.claude/logs/
.claude/worktrees/
.claude/commands/idea-*
.claude/ship-loop/
.claude/gap-loop/
.claude/craft-loop/
.claude/green-loop/
.claude/readiness-loop/

# Windows reserved name artifacts
nul

# Regenerable test / capture / scenario run outputs (not source; keep out of the repo).
# shots/*.py + *.mjs tooling scripts stay tracked; only the capture OUTPUTS are ignored.
/test-results/
/playwright-report/
/sword-run/
/scn-*
/*.log
shots/*/
shots/*.log
shots/*.json
shots/*.mp4
shots/*.png

# typescript
*.tsbuildinfo
next-env.d.ts

# auto-generated by scripts/gen-pipeline-registry.mjs
src/lib/catalog/pipelines/registry.generated.ts

# generated context scan reports
docs/contexts/

# pof-mcp standalone package (built + installed separately)
tools/pof-mcp/node_modules/
tools/pof-mcp/dist/
# machine-local UE growth ratchet baseline (GROWTH-LOG.md is committed)
tools/pof-mcp/growth-baseline.json

# Local generated 3D assets (zero-budget TripoSR pipeline) — not committed
/generated/

# Playwright seeded storage state (regenerated each run by e2e/global-setup.ts)
/e2e/.auth/

# Bleve docs search index (regenerated, not source)
docs/index.bleve/

# Transient skill → Personas Memory Ledger handoff. Context-tracked skills
# append progress nodes here; the app ingests the file and deletes it. The
# .personas/ dir itself IS committed (it marks the repo as Personas-managed).
.personas/memory-outbox.jsonl

# Throwaway hermetic SQLite the Playwright suite runs against (e2e/helpers/e2e-db.ts)
/e2e/.tmp/

# Loop scratch (measurement runs, A/B probe output) — regenerated, never shipped
/.tmp-green/
/.tmp-groupc/
/.tmp-measure/
/ab-results.json
/.benchmark-tripo/

# /consult skill log (counts reach the ai-registry signals lane; the log itself stays local)
.ai/consults.jsonl

# BEGIN ai-registry linked skills (managed by ai-registry/scripts/link-skills.mjs)
# The links are machine state; the declaration lives in .ai/manifest.yaml `skills:`.
/.claude/skills/consult
/.claude/skills/npm-updates
/.claude/skills/perfect
/.claude/skills/ship-loop
# END ai-registry linked skills

# BEGIN ai-registry linked skills (managed by ai-registry/scripts/link-registry.mjs)
# Links are machine state; the declarations live in .ai/manifest.yaml (`skills:` and `knowledge.domains`).
/.claude/skills/conform
/.claude/skills/consult
/.claude/skills/npm-updates
/.claude/skills/perfect
/.claude/skills/ship-loop
/.claude/rules/ai-registry-access.md
/.claude/rules/ai-registry-game-production.md
/.claude/rules/ai-registry-software-engineering.md
# END ai-registry linked skills
