  "text": "The delivery has to validate as two act-1 proposals before I reply with the array. I'll check it against the council schema.[\n  {\n    \"schema\": \"gtai.questProposal/1\",\n    \"seat\": \"grok\",\n    \"variant\": \"A\",\n    \"pathId\": \"grok-A\",\n    \"act\": \"act1\",\n    \"title\": \"Service of Process\",\n    \"logline\": \"Don Fax faxes Rivet a final notice on a notary who served the Family by email, and Krump steals the credit over the radio.\",\n    \"goal\": \"Kill Stamp on the courthouse steps and collect Don Fax's nine hundred from the booth.\",\n    \"whyNotFiller\": \"The paper-jam FUCK is the laugh, Stamp asking to be signed in halves is paperwork used as a weapon, and Krump claiming the corpse on the radio is the turn that opens his housekeeping questline while Don Fax never names who else is copied.\",\n    \"characters\": [\n      {\n        \"id\": \"patch\",\n        \"name\": \"Patch\",\n        \"status\": \"existing\",\n        \"role\": \"voice\"\n      },\n      {\n        \"id\": \"don-fax\",\n        \"name\": \"Don Fax\",\n        \"status\": \"existing\",\n        \"role\": \"giver\"\n      },\n      {\n        \"id\": \"rivet\",\n        \"name\": \"Rivet\",\n        \"status\": \"existing\",\n        \"role\": \"voice\"\n      },\n      {\n        \"id\": \"stamp\",\n        \"name\": \"Stamp\",\n        \"status\": \"new\",\n        \"role\": \"target\",\n        \"designNote\": \"Waist-high notary robot with a rubber-stamp head, a red ink-pad chest, and a paper scroll for a tail; the stamp face reads clearly from above.\"\n      },\n      {\n        \"id\": \"general-krump\",\n        \"name\": \"General Krump\",\n        \"status\": \"existing\",\n        \"role\": \"antagonist\"\n      },\n      {\n        \"id\": \"mc-crumbtray\",\n        \"name\": \"MC Crumbtray\",\n        \"status\": \"existing\",\n        \"role\": \"voice\"\n      }\n    ],\n    \"beats\": [\n      {\n        \"id\": \"the-booth\",\n        \"title\": \"The booth\",\n        \"summary\": \"A payphone rings. Patch routes it and hangs up, and Don Fax's final notice prints out of the coin slot and jams.\",\n        \"objective\": {\n          \"verb\": \"answer\",\n          \"target\": \"payphone\",\n          \"location\": \"Ninth Street booth\"\n        },\n        \"lineIds\": [\"a-patch-booth\", \"a-fax-notice\", \"a-rivet-clock-in\"]\n      },\n      {\n        \"id\": \"the-steps\",\n        \"title\": \"The steps\",\n        \"summary\": \"Rivet climbs the courthouse steps, and Stamp tries to notarize the welder into two neat halves.\",\n        \"objective\": {\n          \"verb\": \"kill\",\n          \"target\": \"stamp\",\n          \"location\": \"courthouse steps\"\n        },\n        \"lineIds\": [\"a-rivet-steps\", \"a-stamp-service\", \"a-rivet-signed\"]\n      },\n      {\n        \"id\": \"the-credit\",\n        \"title\": \"The credit\",\n        \"summary\": \"Krump comes on the radio, takes the credit, and offers the next housekeeping cheque. CRUMB FM burns him for it. Don Fax pays at the booth.\",\n        \"objective\": {\n          \"verb\": \"collect\",\n          \"target\": \"payout\",\n          \"location\": \"Ninth Street booth\"\n        },\n        \"lineIds\": [\"a-krump-credit\", \"a-rivet-unit\", \"a-crumb-stamp\", \"a-fax-payout\", \"a-rivet-nine\"]\n      }\n    ],\n    \"lines\": [\n      {\n        \"id\": \"a-patch-booth\",\n        \"speaker\": \"patch\",\n        \"purpose\": [\"progression\", \"character\"],\n        \"text\": \"You there? Job. Courthouse steps. Party says paper. Click.\",\n        \"audio\": null\n      },\n      {\n        \"id\": \"a-fax-notice\",\n        \"speaker\": \"don-fax\",\n        \"purpose\": [\"funny\", \"character\", \"progression\"],\n        \"text\": \"PER MY LAST FAX: the recipient served this Family by email, kid, and email is a disease. Point one, his stamp. Point two, his face. Point three, see points one and two. Hold on, paper jam. FUCK. My soul has a paper jam. That was an act of God. Regards.\",\n        \"audio\": null\n      },\n      {\n        \"id\": \"a-rivet-clock-in\",\n        \"speaker\": \"rivet\",\n        \"purpose\": [\"funny\", \"character\"],\n        \"text\": \"Courthouse. I clock in.\",\n        \"audio\": null\n      },\n      {\n        \"id\": \"a-rivet-steps\",\n        \"speaker\": \"rivet\",\n        \"purpose\": [\"funny\", \"character\"],\n        \"text\": \"Steps are dirty. I go up.\",\n        \"when\": [\"objective:approach\"],\n        \"audio\": null\n      },\n      {\n        \"id\": \"a-stamp-service\",\n        \"speaker\": \"stamp\",\n        \"purpose\": [\"funny\", \"progression\"],\n        \"text\": \"Hold still, signer. This is service. Sign here, sign there, sign in halves.\",\n        \"when\": [\"target:spotted\"],\n        \"audio\": null\n      },\n      {\n        \"id\": \"a-rivet-signed\",\n        \"speaker\": \"rivet\",\n        \"purpose\": [\"funny\", \"character\"],\n        \"text\": \"Signed in halves. Clocking out.\",\n        \"when\": [\"event:target-killed\"],\n        \"audio\": null\n      },\n      {\n        \"id\": \"a-krump-credit\",\n        \"speaker\": \"general-krump\",\n        \"purpose\": [\"funny\", \"character\", \"progression\"],\n        \"text\": \"Son, that appliance you decommissioned was a dangerous rogue with OPINIONS, and my budget has already written your next housekeeping cheque, which I will be presenting to myself. Krump out.\",\n        \"when\": [\"radio:open\"],\n        \"audio\": null\n      },\n      {\n        \"id\": \"a-rivet-unit\",\n        \"speaker\": \"rivet\",\n        \"purpose\": [\"funny\", \"character\"],\n        \"text\": \"Not your unit.\",\n        \"when\": [\"radio:open\"],\n        \"audio\": null\n      },\n      {\n        \"id\": \"a-crumb-stamp\",\n        \"speaker\": \"mc-crumbtray\",\n        \"purpose\": [\"funny\", \"progression\"],\n        \"text\": \"CRUMB FM nation, the Mystery Welder just notarized a man into pieces! POP! Holy (bleep) shit, listeners, the General Malfunction is taking credit for a stamp!\",\n        \"when\": [\"radio:open\"],\n        \"audio\": null\n      },\n      {\n        \"id\": \"a-fax-payout\",\n        \"speaker\": \"don-fax\",\n        \"purpose\": [\"funny\", \"character\", \"progression\"],\n        \"text\": \"Point one, the recipient is filed. Point two, nine hundred dollars, laminated thanks enclosed. Point three, see point one. Regards.\",\n        \"audio\": null\n      },\n      {\n        \"id\": \"a-rivet-nine\",\n        \"speaker\": \"rivet\",\n        \"purpose\": [\"funny\", \"character\"],\n        \"text\": \"Nine hundred. Shift's done.\",\n        \"audio\": null\n      }\n    ],\n    \"mechanics\": [\n      {\n        \"id\": \"payphone-router\",\n        \"name\": \"Payphone job router\",\n        \"status\": \"existing\",\n        \"home\": \"game\",\n        \"summary\": \"A booth rings, Patch routes the party, and Don Fax's notice prints from the coin slot.\"\n      },\n      {\n        \"id\": \"heat\",\n        \"name\": \"Heat\",\n        \"status\": \"existing\",\n        \"home\": \"game\",\n        \"summary\": \"Killing Stamp on the steps raises heat to 2. A second wave arrives if Rivet lingers.\"\n      },\n      {\n        \"id\": \"radio-broadcast\",\n        \"name\": \"Diegetic radio\",\n        \"status\": \"existing\",\n        \"home\": \"game\",\n        \"summary\": \"Krump cuts in to claim the kill, and CRUMB FM mocks him on the same band.\"\n      }\n    ],\n    \"reward\": {\n      \"cash\": 900,\n      \"unlocks\": [\"krump-radio-channel\"]\n    },\n    \"difficulty\": {\n      \"heatPeak\": 2,\n      \"enemyCount\": 8,\n      \"enemyWaves\": 2,\n      \"timeLimitS\": null,\n      \"failStates\": [\n        \"Rivet is scrapped\",\n        \"Stamp reaches the mail truck and serves the block\",\n        \"Heat locks the courthouse doors\"\n      ],\n      \"minutes\": 8\n    },\n    \"story\": {\n      \"reads\": [],\n      \"writes\": [\n        {\"var\": \"don_fax.jobs_done\", \"value\": 1},\n        {\"var\": \"krump.questline\", \"value\": \"offered\"}\n      ]\n    },\n    \"fingerprint\": {\n      \"giver\": \"don-fax\",\n      \"coreVerb\": \"kill\",\n      \"newMechanic\": null,\n      \"location\": \"courthouse steps\",\n      \"payoffKind\": \"cash\"\n    }\n  },\n  {\n    \"schema\": \"gtai.questProposal/1\",\n    \"seat\": \"grok\",\n    \"variant\": \"B\",\n    \"pathId\": \"grok-B\",\n    \"act\": \"act1\",\n    \"title\": \"Never a Scratch\",\n    \"logline\": \"The Valet has Rivet retrieve a general's staff car from impound, and the dead driver in the seat wakes as Gearbox.\",\n    \"goal\": \"Relocate the staff car from the municipal impound to bay nine and leave with Gearbox awake.\",\n    \"whyNotFiller\": \"Gearbox's calm Mirror-signal-MURDER while he grabs the wheel is the laugh in the hands, Krump insisting he invented beige is the vanity joke, and the dead driver staying in Rivet's head unlocks soul 1.\",\n    \"characters\": [\n      {\n        \"id\": \"the-valet\",\n        \"name\": \"The Valet\",\n        \"status\": \"existing\",\n        \"role\": \"giver\"\n      },\n      {\n        \"id\": \"rivet\",\n        \"name\": \"Rivet\",\n        \"status\": \"existing\",\n        \"role\": \"voice\"\n      },\n      {\n        \"id\": \"gearbox\",\n        \"name\": \"Gearbox\",\n        \"status\": \"existing\",\n        \"role\": \"voice\"\n      },\n      {\n        \"id\": \"general-krump\",\n        \"name\": \"General Krump\",\n        \"status\": \"existing\",\n        \"role\": \"antagonist\"\n      }\n    ],\n    \"beats\": [\n      {\n        \"id\": \"the-ticket\",\n        \"title\": \"The ticket\",\n        \"summary\": \"The Valet hands over a ticket for a general's staff car as if Rivet were collecting a dinner guest.\",\n        \"objective\": {\n          \"verb\": \"accept\",\n          \"location\": \"the valet stand\"\n        },\n        \"lineIds\": [\"b-valet-ticket\", \"b-valet-aide\", \"b-rivet-impound\"]\n      },\n      {\n        \"id\": \"the-impound\",\n        \"title\": \"The impound\",\n        \"summary\": \"Rivet turns the key in the impound lockup. The driver who was on break wakes up and takes an interest in the wheel.\",\n        \"objective\": {\n          \"verb\": \"relocate\",\n          \"target\": \"staff car\",\n          \"location\": \"municipal impound\"\n        },\n        \"lineIds\": [\"b-gearbox-wheel\", \"b-rivet-talks\"]\n      },\n      {\n        \"id\": \"the-ramp\",\n        \"title\": \"The ramp\",\n        \"summary\": \"Krump's jeeps chase the car. At the Choir band Gearbox grabs the wheel, and Rivet wrestles the stick or lets him have the ramp.\",\n        \"objective\": {\n          \"verb\": \"evade\",\n          \"target\": \"motor-pool jeeps\",\n          \"location\": \"the parade ramp\"\n        },\n        \"lineIds\": [\"b-krump-beige\", \"b-gearbox-brake\", \"b-gearbox-calm\", \"b-rivet-clock-out\"]\n      },\n      {\n        \"id\": \"the-bay\",\n        \"title\": \"Bay nine\",\n        \"summary\": \"The curb leaves a mark. The Valet swears, then denies it, and Gearbox does not get out.\",\n        \"objective\": {\n          \"verb\": \"deliver\",\n          \"target\": \"staff car\",\n          \"location\": \"bay nine\"\n        },\n        \"lineIds\": [\"b-valet-mark\", \"b-valet-never\", \"b-gearbox-break\", \"b-rivet-stays\"]\n      }\n    ],\n    \"lines\": [\n      {\n        \"id\": \"b-valet-ticket\",\n        \"speaker\": \"the-valet\",\n        \"purpose\": [\"progression\", \"character\"],\n        \"text\": \"Would sir be so kind as to retrieve her from level three, sir?\",\n        \"audio\": null\n      },\n      {\n        \"id\": \"b-valet-aide\",\n        \"speaker\": \"the-valet\",\n        \"purpose\": [\"funny\", \"character\", \"progression\"],\n        \"text\": \"The previous driver was a general's aide, sir.\",\n        \"audio\": null\n      },\n      {\n        \"id\": \"b-rivet-impound\",\n        \"speaker\": \"rivet\",\n        \"purpose\": [\"funny\", \"character\"],\n        \"text\": \"Municipal impound. I drive.\",\n        \"audio\": null\n      },\n      {\n        \"id\": \"b-gearbox-wheel\",\n        \"speaker\": \"gearbox\",\n        \"purpose\": [\"funny\", \"character\", \"progression\"],\n        \"text\": \"Buddy, turn it, turn it, I have the wheel — wait, whose beige is this, pal, whose beige is on the seats?\",\n        \"when\": [\"vehicle:entered\"],\n        \"audio\": null\n      },\n      {\n        \"id\": \"b-rivet-talks\",\n        \"speaker\": \"rivet\",\n        \"purpose\": [\"funny\", \"character\"],\n        \"text\": \"The car talks. I did not order that.\",\n        \"when\": [\"vehicle:entered\"],\n        \"audio\": null\n      },\n      {\n        \"id\": \"b-krump-beige\",\n        \"speaker\": \"general-krump\",\n        \"purpose\": [\"funny\", \"character\", \"progression\"],\n        \"text\": \"Son, that staff car is LIBERTY on wheels, and the appliance driving her knew things about beige, a color I personally invented for the motor pool. Krump out.\",\n        \"when\": [\"radio:open\"],\n        \"audio\": null\n      },\n      {\n        \"id\": \"b-gearbox-brake\",\n        \"speaker\": \"gearbox\",\n        \"purpose\": [\"funny\", \"character\"],\n        \"text\": \"Brake, BRAKE, the other brake, buddy, the jeep is in the mirror and in the cupholder — oh fuck oh fuck, did you check your six?\",\n        \"when\": [\"heat:2+\"],\n        \"audio\": null\n      },\n      {\n        \"id\": \"b-gearbox-calm\",\n        \"speaker\": \"gearbox\",\n        \"purpose\": [\"funny\", \"character\", \"progression\"],\n        \"text\": \"Mirror, signal, MURDER.\",\n        \"when\": [\"madness:choir\"],\n        \"audio\": null\n      },\n      {\n        \"id\": \"b-rivet-clock-out\",\n        \"speaker\": \"rivet\",\n        \"purpose\": [\"funny\", \"character\"],\n        \"text\": \"Clocking out.\",\n        \"when\": [\"event:pursuer-killed\"],\n        \"audio\": null\n      },\n      {\n        \"id\": \"b-valet-mark\",\n        \"speaker\": \"the-valet\",\n        \"purpose\": [\"funny\", \"character\"],\n        \"text\": \"The curb has left a — fucking — mark on her door, sir.\",\n        \"audio\": null\n      },\n      {\n        \"id\": \"b-valet-never\",\n        \"speaker\": \"the-valet\",\n        \"purpose\": [\"funny\", \"character\"],\n        \"text\": \"Never a scratch, sir. Enjoy your evening.\",\n        \"audio\": null\n      },\n      {\n        \"id\": \"b-gearbox-break\",\n        \"speaker\": \"gearbox\",\n        \"purpose\": [\"funny\", \"character\", \"progression\"],\n        \"text\": \"I'm on break, buddy, a long break, and the route is ours now — wait, is it ours, pal, did you check the mirror?\",\n        \"when\": [\"soul:gearbox\"],\n        \"audio\": null\n      },\n      {\n        \"id\": \"b-rivet-stays\",\n        \"speaker\": \"rivet\",\n        \"purpose\": [\"character\", \"progression\"],\n        \"text\": \"Gearbox stays. I drive.\",\n        \"audio\": null\n      }\n    ],\n    \"mechanics\": [\n      {\n        \"id\": \"driving\",\n        \"name\": \"Driving\",\n        \"status\": \"existing\",\n        \"home\": \"game\",\n        \"summary\": \"Rivet drives the staff car from the impound lockup to bay nine while jeeps pursue.\"\n      },\n      {\n        \"id\": \"gearbox-car-manipulation\",\n        \"name\": \"Gearbox car manipulation\",\n        \"status\": \"existing\",\n        \"home\": \"game\",\n        \"summary\": \"Turning the key wakes Gearbox. He backseat-drives, and at Choir he grabs the wheel for one beat.\"\n      },\n      {\n        \"id\": \"madness-grip\",\n        \"name\": \"Choir grab-the-wheel\",\n        \"status\": \"existing\",\n        \"home\": \"game\",\n        \"summary\": \"At the Choir band Gearbox takes the ramp. Rivet wrestles the stick or gives him the wheel.\"\n      }\n    ],\n    \"reward\": {\n      \"cash\": 1100,\n      \"unlocks\": [\"gearbox\"]\n    },\n    \"difficulty\": {\n      \"heatPeak\": 3,\n      \"enemyCount\": 12,\n      \"enemyWaves\": 3,\n      \"timeLimitS\": null,\n      \"failStates\": [\n        \"Rivet is scrapped\",\n        \"The staff car is wrecked\",\n        \"The impound cordon closes on the car\"\n      ],\n      \"minutes\": 11\n    },\n    \"story\": {\n      \"reads\": [],\n      \"writes\": [\n        {\"var\": \"souls.gearbox.unlocked\", \"value\": true}\n      ]\n    },\n    \"fingerprint\": {\n      \"giver\": \"the-valet\",\n      \"coreVerb\": \"relocate\",\n      \"newMechanic\": null,\n      \"location\": \"municipal impound\",\n      \"payoffKind\": \"soul-unlock\"\n    }\n  }\n]",
