{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gtai.questProposal/1",
  "title": "GTAI quest council proposal (gtai.questProposal/1)",
  "description": "Mirrors QuestProposal in src/lib/games/gtai-quest/types.ts. A council seat delivers a JSON array [A, B] of these. Absent-value convention: OMIT a key for 'not applicable' (target, location, when); null is a claim (timeLimitS null = no timer, audio null = not recorded, newMechanic null = no new mechanic).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "seat",
    "variant",
    "pathId",
    "act",
    "title",
    "logline",
    "goal",
    "whyNotFiller",
    "characters",
    "beats",
    "lines",
    "mechanics",
    "reward",
    "difficulty",
    "story",
    "fingerprint"
  ],
  "properties": {
    "schema": {
      "const": "gtai.questProposal/1"
    },
    "seat": {
      "enum": [
        "claude",
        "grok"
      ]
    },
    "variant": {
      "enum": [
        "A",
        "B"
      ]
    },
    "pathId": {
      "type": "string",
      "pattern": "^(claude|grok)-(A|B)$",
      "description": "`<seat>-<variant>`; must agree with seat and variant."
    },
    "act": {
      "enum": [
        "prologue",
        "clock-out",
        "act1",
        "act2",
        "act3",
        "act4",
        "finale"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "logline": {
      "type": "string",
      "minLength": 1,
      "description": "One sentence."
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "whyNotFiller": {
      "type": "string",
      "minLength": 1
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "status",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "existing",
              "new"
            ]
          },
          "role": {
            "enum": [
              "giver",
              "target",
              "ally",
              "voice",
              "bystander",
              "antagonist"
            ]
          },
          "designNote": {
            "type": "string",
            "minLength": 1,
            "description": "Required when status is new (checked by the council validator)."
          }
        }
      }
    },
    "beats": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "summary",
          "objective",
          "lineIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "objective": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "verb"
            ],
            "properties": {
              "verb": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string"
              },
              "location": {
                "type": "string"
              }
            }
          },
          "lineIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "speaker",
          "purpose",
          "text",
          "audio"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "speaker": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "funny",
                "character",
                "progression"
              ]
            }
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "audio": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "file",
                  "voice"
                ],
                "properties": {
                  "file": {
                    "type": "string"
                  },
                  "voice": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "mechanics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "status",
          "home",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "existing",
              "new"
            ]
          },
          "home": {
            "enum": [
              "game",
              "pof"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "reward": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cash",
        "unlocks"
      ],
      "properties": {
        "cash": {
          "type": "number",
          "minimum": 0
        },
        "unlocks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "difficulty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "heatPeak",
        "enemyCount",
        "enemyWaves",
        "timeLimitS",
        "failStates",
        "minutes"
      ],
      "properties": {
        "heatPeak": {
          "type": "number",
          "minimum": 0,
          "maximum": 6
        },
        "enemyCount": {
          "type": "number",
          "minimum": 0
        },
        "enemyWaves": {
          "type": "number",
          "minimum": 0
        },
        "timeLimitS": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ]
        },
        "failStates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "minutes": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reads",
        "writes"
      ],
      "properties": {
        "reads": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "writes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "var",
              "value"
            ],
            "properties": {
              "var": {
                "type": "string",
                "minLength": 1
              },
              "value": {}
            }
          }
        }
      }
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "giver",
        "coreVerb",
        "newMechanic",
        "location",
        "payoffKind"
      ],
      "properties": {
        "giver": {
          "type": "string",
          "minLength": 1
        },
        "coreVerb": {
          "type": "string",
          "minLength": 1
        },
        "newMechanic": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "payoffKind": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}